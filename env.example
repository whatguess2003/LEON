# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# Postgres (Railway now, Hyperdrive or a pooler later)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required: signs sign-in tokens. Generate a long random value; the server refuses to start without it.
JWT_SECRET=replace-with-a-long-random-secret

# Required on both the main server and the channel manager: signs the main server's calls to the channel manager.
# Unset refuses every channel manager call except /health and the Aiosell webhook.
CM_SERVICE_SECRET=replace-with-a-long-random-secret

# Platform team header X-Leon-Admin-Token for /api/admin/complaints. Unset refuses every admin call.
LEON_PLATFORM_ADMIN_TOKEN=replace-with-a-long-random-token

# Anthropic API key: the desk's chat model (booking_system/llm_utils.py, booking_system/semantic/desk.py). Without it every chat turn fails.
ANTHROPIC_API_KEY=
