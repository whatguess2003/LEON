{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cm",
  "main": "workers/cm.js",
  "compatibility_date": "2026-10-22",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "CmService",
      "scheduling_policy": "default",
      "image": "./Dockerfile.cm",
      "instance_type": "standard-1",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CM",
        "class_name": "CmService"
      }
    ]
  },
  "exports": {
    "CmService": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "CmContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "FRONTEND_ORIGINS": "https://inap.ai,https://leon.whatguess2003.workers.dev,https://static.whatguess2003.workers.dev",
    "AIOSSELL_PARTNER_ID": "sample-pms"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "routes": [
    {
      "pattern": "cm.inap.ai",
      "custom_domain": true
    }
  ]
}
