{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pms",
  "main": "workers/pms.js",
  "compatibility_date": "2026-10-22",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "PmsService",
      "scheduling_policy": "default",
      "image": "./Dockerfile.pms",
      "instance_type": "standard-1",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PMS",
        "class_name": "PmsService"
      }
    ]
  },
  "exports": {
    "pms_PmsService": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "PmsService": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "PmsContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "CHANNEL_MANAGER_URL": "https://cm.inap.ai",
    "FRONTEND_ORIGINS": "https://inap.ai,https://leon.whatguess2003.workers.dev,https://static.whatguess2003.workers.dev",
    "AIOSSELL_PARTNER_ID": "sample-pms"
  },
  "routes": [
    {
      "pattern": "api.inap.ai/*",
      "zone_name": "inap.ai"
    }
  ]
}
