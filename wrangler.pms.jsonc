{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pms",
  "main": "workers/pms.js",
  "compatibility_date": "2026-10-22",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      "binding": "DATABASE_URL",
      "id": "ff0f7ba9bb09464baa17495513a9575f"
    }
  ],
  "containers": [
    {
      "class_name": "PmsService",
      "scheduling_policy": "default",
      "image": "registry.cloudflare.com/332c5e41cdaf724cedc69e812890fa6d/pms:20261104a",
      "instance_type": "standard-1",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PMS",
        "class_name": "PmsService"
      }
    ]
  },
  "exports": {
    "PmsService": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "PmsContainer": {
      "type": "durable-object",
      "state": "deleted"
    },
    "pms_PmsService": {
      "type": "durable-object",
      "state": "deleted"
    }
  },
  "vars": {
    "DATABASE_ORIGIN_HOST": "aws-ap-southeast-1-2.pg.psdb.cloud",
    "DATABASE_ORIGIN_PORT": "5432",
    "DATABASE_ORIGIN_USER": "pscale_api_v32ys5j32ygv.phl6g5lt1ubh",
    "CHANNEL_MANAGER_URL": "https://cm.inap.ai",
    "FRONTEND_ORIGINS": "https://inap.ai,https://leon.whatguess2003.workers.dev,https://static.whatguess2003.workers.dev,https://beta.inap.ai",
    "AIOSSELL_PARTNER_ID": "sample-pms"
  },
  "routes": [
    {
      "pattern": "api.inap.ai/*",
      "zone_name": "inap.ai"
    }
  ]
}
